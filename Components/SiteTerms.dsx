          <stack class="ds ds-inline siteterms-1u">
            <text class="ds ds-text" value="These Terms are governed by UAE law as applied in Dubai. Disputes go to arbitration at the Dubai International Arbitration Centre, in English, with a single arbitrator. The arbitrator’s decision is final and binding. Claims must be brought within one year of the issue arising."/>
          </stack>
        </stack>
        <stack class="ds siteterms-1v">
          <stack class="ds ds-inline siteterms-1w">
            <text class="ds ds-text" value="Force Majeure"/>
          </stack>
          <stack class="ds ds-inline siteterms-1x">
            <text class="ds ds-text" value="Despia is not liable for delays or failures caused by events beyond our reasonable control, including natural disasters, pandemics, war, government actions, cyberattacks, power or internet outages, or labour disputes."/>
          </stack>
        </stack>
        <stack class="ds siteterms-1y">
          <stack class="ds ds-inline siteterms-1z">
            <text class="ds ds-text" value="General"/>
          </stack>
          <stack class="ds ds-inline siteterms-20">
            <text class="ds ds-text" value="If any provision is unenforceable, the rest still applies and the unenforceable provision will be modified to the minimum extent necessary. These Terms and our Privacy Policy are the entire agreement between you and Despia and supersede all prior agreements. No waiver of any provision constitutes a continuing waiver. We may update these Terms and will post changes with an updated date. Continued use means acceptance."/>
          </stack>
