        <svg class="ds ds-svg siteterms-2" slot="logo" src="&lt;svg fill=&quot;currentColor&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; viewBox=&quot;0 0 400 400&quot;&gt;&lt;path d=&quot;M200,0C89.54,0,0,89.54,0,200c110.46,0,200-89.54,200-200&quot;/&gt;&lt;path d=&quot;M0,200H0C0,310.46,89.54,400,200,400c0-110.46-89.54-200-200-200&quot;/&gt;&lt;path d=&quot;M200,400c110.46,0,200-89.54,200-200h0c-110.46,0-200,89.54-200,200&quot;/&gt;&lt;path d=&quot;M317.75 161.05 C359.37 161.05 393.11 127.31 393.11 85.69 C393.11 44.07 359.37 10.33 317.75 10.33 C276.13 10.33 242.39 44.07 242.39 85.69 C242.39 105.677 250.33 124.845 264.462 138.978 C278.595 153.11 297.763 161.05 317.75 161.05&quot;/&gt;&lt;/svg&gt;"/>
