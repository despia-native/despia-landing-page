      <stack class="ds siteterms-3">
        <stack class="ds siteterms-4">
          <stack class="ds ds-inline siteterms-5">
            <text class="ds ds-text" value="Terms of Service"/>
          </stack>
          <stack class="ds ds-inline siteterms-6">
            <text class="ds ds-text" value="The rules of the road for using Despia. We’ve kept it short, clear, and fair."/>
          </stack>
          <stack class="ds siteterms-7">
            <text class="ds ds-text" value="Despia LLC – FZ"/>
            <text class="ds ds-text" value="Dubai, UAE"/>
            <text class="ds ds-text" value="Effective Feb 16, 2026"/>
          </stack>
        </stack>
        <stack class="ds siteterms-8">
          <stack class="ds ds-inline siteterms-9">
            <text class="ds ds-text" value="Agreement"/>
          </stack>
          <stack class="ds ds-inline siteterms-a">
            <text class="ds ds-text" value="By using Despia’s platform, APIs, SDK, build tools, or related services (“Services”), you agree to these Terms and our Privacy Policy. If you’re representing an organization, you confirm you have the authority to accept on its behalf."/>
          </stack>
        </stack>
        <stack class="ds siteterms-b">
          <stack class="ds ds-inline siteterms-c">
            <text class="ds ds-text" value="Our Services"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia is a native runtime for web applications. The platform provides a GPU-accelerated native container for iOS and Android that runs your existing web application with full hardware access, native SDK integrations, on-device local server capabilities, over-the-air update infrastructure, and developer documentation."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia also integrates with the Apple App Store and Google Play Store developer ecosystems to provide automated build, signing, and deployment tooling that simplifies your CI/CD pipeline from code to live store listing."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia does not host or serve your web application, its content, or its user data. Your application runs from your own hosting infrastructure or from an on-device local server that caches assets directly from your hosting. You retain full control of your servers, databases, and deployment pipeline."/>
          </stack>
        </stack>
        <stack class="ds siteterms-d">
          <stack class="ds ds-inline siteterms-e">
            <text class="ds ds-text" value="Hosting &amp; Infrastructure"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia is a runtime and build toolchain, not a hosting provider. All web content, application logic, end-user data, databases, APIs, and backend services remain on your own infrastructure. Despia’s native container fetches and renders content directly from your servers or from the device’s local cache. Your application content does not pass through or reside on Despia’s servers."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="You are solely responsible for your hosting environment, its availability, security, data handling, and compliance with applicable laws. Despia has no access to, control over, or responsibility for any end-user data processed by your application or stored on your infrastructure."/>
          </stack>
        </stack>
        <stack class="ds siteterms-f">
          <stack class="ds ds-inline siteterms-g">
            <text class="ds ds-text" value="Data Despia Processes"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="While Despia does not host your application or its user data, we do process certain app-related data to provide our build, deployment, and platform services. This includes:"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="App store listing metadata such as app names, descriptions, categories, and keywords. App icons, screenshots, and other store listing assets you provide. Bundle identifiers, version numbers, build configurations, and signing credentials. Account information you provide during registration."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="This data may be shared with trusted partners and service providers who assist with CI/CD pipeline operations, app store build and deployment processing, and AI-powered processing of app-related data (such as metadata optimization and asset processing). We share only the minimum data necessary for these services to function."/>
          </stack>
          <stack class="ds siteterms-h">
            <text class="ds ds-text" value="Sensitive credentials such as signing keys, certificates, and API tokens are stored using encryption at rest. Access to these credentials is restricted and logged. You may revoke or rotate your credentials at any time through your account settings."/>
          </stack>
        </stack>
        <stack class="ds siteterms-i">
          <stack class="ds ds-inline siteterms-j">
            <text class="ds ds-text" value="Your Account"/>
          </stack>
          <stack class="ds ds-inline siteterms-k">
            <text class="ds ds-text" value="You must be 18 or older. Keep your credentials secure and your registration info accurate. You’re responsible for all activity under your account. If something looks wrong, let us know at "/>
            <pressable class="ds ds-a siteterms-l" href="mailto:report@despia.com">
              <text class="ds ds-text" value="report@despia.com"/>
            </pressable>
          </stack>
        </stack>
        <stack class="ds siteterms-m">
          <stack class="ds ds-inline siteterms-n">
            <text class="ds ds-text" value="Using Despia"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="We grant you a non-exclusive, revocable license to use the platform for building and deploying your applications. You may not reverse-engineer the platform, resell access, or build a competing product with it."/>
          </stack>
        </stack>
        <stack class="ds siteterms-o">
          <stack class="ds ds-inline siteterms-p">
            <text class="ds ds-text" value="Acceptable Use"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Use Despia lawfully and responsibly. Don’t use the platform to build or distribute anything illegal, access systems without authorization, spread malware or fraudulent content, infringe on intellectual property or personal rights, create harmful or exploitative material, or disrupt the platform."/>
          </stack>
          <stack class="ds ds-inline siteterms-q">
            <text class="ds ds-text" value="Under UAE Federal Decree-Law No. 34 of 2021, unlawful use of technology platforms is a criminal offence. Despia complies with UAE law and cooperates with authorities when required. Report concerns to "/>
            <pressable class="ds ds-a siteterms-r" href="mailto:report@despia.com">
              <text class="ds ds-text" value="report@despia.com"/>
            </pressable>
          </stack>
        </stack>
        <stack class="ds siteterms-s">
          <stack class="ds ds-inline siteterms-t">
            <text class="ds ds-text" value="Your Content &amp; Applications"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="You own everything you build. Despia does not claim any ownership of your code, content, applications, or data. Because Despia does not host your application content, we do not have access to or control over the applications you deploy or the end-user data they process."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="You are solely and entirely responsible for your applications, including their content, functionality, legality, data handling practices, end-user agreements, and compliance with all applicable laws. Despia provides runtime and build tooling only and bears no responsibility for what you build, deploy, or distribute using the Services."/>
          </stack>
        </stack>
        <stack class="ds siteterms-u">
          <stack class="ds ds-inline siteterms-v">
            <text class="ds ds-text" value="Intellectual Property"/>
          </stack>
          <stack class="ds ds-inline siteterms-w">
            <text class="ds ds-text" value="The Despia platform, SDK, runtime, brand, logo, and documentation are our property. Nothing in these Terms transfers Despia IP to you."/>
          </stack>
        </stack>
        <stack class="ds siteterms-x">
          <stack class="ds ds-inline siteterms-y">
            <text class="ds ds-text" value="Pricing &amp; Payment"/>
