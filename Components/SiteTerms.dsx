          <stack class="ds ds-inline siteterms-16">
            <text class="ds ds-text" value="Despia integrates with the Apple App Store, Google Play Store, and third-party services including RevenueCat, OneSignal, and others. These services operate under their own terms and privacy policies."/>
          </stack>
          <stack class="ds ds-inline siteterms-17">
            <text class="ds ds-text" value="Despia works with trusted partners and service providers to deliver parts of the Services, including CI/CD infrastructure, build processing, and AI-powered features. These partners may process app-related data (as described in “Data Despia Processes” above) on our behalf and are bound by confidentiality obligations. Despia is not responsible for the operation of third-party services, and your use of them is at your own risk."/>
          </stack>
        </stack>
        <stack class="ds siteterms-18">
          <stack class="ds ds-inline siteterms-19">
            <text class="ds ds-text" value="Privacy &amp; Data Protection"/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia processes account and app-related data in accordance with our Privacy Policy and UAE Federal Decree-Law No. 45 of 2021 on the Protection of Personal Data."/>
          </stack>
          <stack class="ds ds-inline">
            <text class="ds ds-text" value="Despia does not host your application or process your end users’ personal data. You are solely responsible for all data processing performed by your application, including compliance with all applicable data protection laws, obtaining proper consent from your users, and maintaining your own privacy policy."/>
          </stack>
        </stack>
        <stack class="ds siteterms-1a">
          <stack class="ds ds-inline siteterms-1b">
            <text class="ds ds-text" value="Availability"/>
          </stack>
          <stack class="ds ds-inline siteterms-1c">
            <text class="ds ds-text" value="We work to keep the Despia build and deployment services reliable. The runtime operates on-device and your application’s availability depends on your own hosting infrastructure, not ours. The Services are provided as-is, without warranties beyond what UAE law requires."/>
          </stack>
        </stack>
        <stack class="ds siteterms-1d">
          <stack class="ds ds-inline siteterms-1e">
            <text class="ds ds-text" value="Disclaimers"/>
          </stack>
          <stack class="ds ds-inline siteterms-1f">
            <text class="ds ds-text" value="THE SERVICES ARE PROVIDED “AS IS” AND “AS AVAILABLE.” TO THE FULLEST EXTENT PERMITTED BY UAE LAW, DESPIA DISCLAIMS ALL WARRANTIES, EXPRESS OR IMPLIED, INCLUDING WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT. DESPIA DOES NOT WARRANT THAT THE SERVICES WILL BE UNINTERRUPTED, ERROR-FREE, OR FREE OF HARMFUL COMPONENTS."/>
          </stack>
          <stack class="ds ds-inline siteterms-1g">
            <text class="ds ds-text" value="DESPIA IS A RUNTIME AND BUILD TOOLCHAIN. DESPIA DOES NOT HOST, MONITOR, REVIEW, OR CONTROL USER APPLICATIONS, THEIR CONTENT, OR THEIR END-USER DATA. DESPIA EXPRESSLY DISCLAIMS ALL LIABILITY FOR USER APPLICATIONS AND ANY CONTENT, DATA, OR SERVICES PROVIDED THROUGH THEM."/>
          </stack>
        </stack>
        <stack class="ds siteterms-1h">
          <stack class="ds ds-inline siteterms-1i">
            <text class="ds ds-text" value="Limitation of Liability"/>
