        <stack class="ds siteterms-10">
          <stack class="ds ds-inline siteterms-11">
            <text class="ds ds-text" value="Refund Policy"/>
          </stack>
          <stack class="ds ds-inline siteterms-12">
            <text class="ds ds-text" value="Refunds are only issued within 14 days of purchase. If 14 days have passed since your purchase, we cannot offer you a refund."/>
          </stack>
          <stack class="ds ds-inline siteterms-13">
            <text class="ds ds-text" value="Please note that our Services are digital products delivered instantly upon purchase. Under UAE Consumer Protection laws and international digital commerce standards, by completing your purchase, you provide your express prior consent for the immediate performance of the contract and acknowledge that you lose your right of withdrawal once the digital content is delivered and the service performance has begun."/>
          </stack>
