<stack class="ds sitespinner-1">
  <head>
    <attribute as="sizePx"/>
    <attribute as="widthPx"/>
    <variable as="id">return 'spinner' + Math.random() * 100000000000000000000</variable>
  </head>
  <stack class="ds ds-inline sitespinner-2"/>
</stack>
