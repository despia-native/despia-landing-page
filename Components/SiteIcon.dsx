  return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M336 336 h40 C398.091 336 416 318.091 416 296 V88 C416 65.909 398.091 48 376 48 H136 C113.909 48 96 65.909 96 88 v208 C96 318.091 113.909 336 136 336 h40" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32"/><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="32" d="M176 240l80-80 80 80M256 464V176"/></svg>'
    </variable>
  </head>
  <svg class="ds-icon ds siteicon-2" visible-if="dsx.attribute.name != 'loader'" style="--width: {{ dsx.attribute.size }}px; --height: {{ dsx.attribute.size }}px" src="{{ dsx.variable.iconArt }}"/>
  <SiteSpinner sizePx="{{ !((dsx.attribute.size == null || String(dsx.attribute.size).length == 0 || String(dsx.attribute.size) == 'undefined' || String(dsx.attribute.size) == '-')) ? dsx.attribute.size : 24 }}" widthPx="2"/>
</stack>
