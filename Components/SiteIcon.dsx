<stack class="ds siteicon-1">
  <head>
    <attribute as="name"/>
    <attribute as="size"/>
    <variable as="iconArt" computed="true">
  if (dsx.attribute.name == 'terminal') return '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path stroke="currentColor" d="M432 32 H80 C44.67 32.039 16.039 60.67 16 96 v320 C16.039 451.33 44.67 479.961 80 480 h352 C467.33 479.961 495.961 451.33 496 416 V96 C495.961 60.67 467.33 32.039 432 32 Z M96 256 C89.206 256 83.153 251.71 80.903 245.299 C78.653 238.889 80.697 231.756 86 227.51 L150.39 176 L86 124.49 C79.096 118.967 77.977 108.894 83.5 101.99 C89.023 95.086 99.096 93.967 106 99.49 l80 64 C189.8 166.526 192.013 171.126 192.013 175.99 C192.013 180.854 189.8 185.454 186 188.49 l-80 64 C103.162 254.762 99.635 256 96 256 Z m160 0 h-64 C183.163 256 176 248.837 176 240 C176 231.163 183.163 224 192 224 h64 C264.837 224 272 231.163 272 240 C272 248.837 264.837 256 256 256 Z"/></svg>'
